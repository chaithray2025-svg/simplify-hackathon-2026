# ---- LLM / Bedrock ----
LLM_PROVIDER=bedrock          # bedrock | mock
AWS_PROFILE=workshop
AWS_DEFAULT_REGION=ap-southeast-1

# Model IDs. This AWS org's SCP restricts Bedrock to ap-southeast-1 only, which
# blocks the global.*/apac.* inference profiles Haiku 4.5 and Sonnet 4.5 require.
# These are confirmed working direct on-demand IDs in ap-southeast-1 — see SETUP.md.
BEDROCK_MODEL_EXTRACTION=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_MODEL_REASONING=anthropic.claude-3-5-sonnet-20240620-v1:0

# ---- Storage ----
# local  -> data/store/*.json  (no AWS, teammates unblocked, $0)
# dynamodb -> real tables in AWS_DEFAULT_REGION
STORAGE_BACKEND=local

# DynamoDB table names (only used when STORAGE_BACKEND=dynamodb)
DDB_TABLE_REVIEWS=simplifynext_reviews
DDB_TABLE_TRENDS=simplifynext_trends
DDB_TABLE_ADVICE=simplifynext_advice
DDB_TABLE_REPLIES=simplifynext_replies
DDB_TABLE_FEEDBACK=simplifynext_feedback

# S3 bucket for raw review payloads (only used when STORAGE_BACKEND=dynamodb)
S3_BUCKET_RAW=simplifynext-raw-reviews
